FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl supervisor \
    && addgroup --system dybpro \
    && adduser --system --ingroup dybpro --home /app dybpro \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=dybpro:dybpro app ./app
COPY --chown=dybpro:dybpro supervisord.cloudflare.conf ./supervisord.cloudflare.conf

RUN mkdir -p /tmp/dyb-pro-artifacts \
    && chown -R dybpro:dybpro /tmp/dyb-pro-artifacts

USER dybpro

EXPOSE 8000
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl --fail --silent --show-error http://127.0.0.1:8000/api/healthz > /dev/null || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/app/supervisord.cloudflare.conf"]
