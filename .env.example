# ---------------------------------------------------------------------------
# DYB Pro environment. Copy to .env — never commit real keys.
# ---------------------------------------------------------------------------

# --- Devin (required for real agent orchestration) -------------------------
# Create an organization service user in Settings > Service users, assign the
# least-privilege DYB Pro role, then generate its one-time cog_ API key.
DEVIN_API_KEY=
# Org id (prefix org-), shown on the same Service users page.
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
# v3 (organization-scoped cog_ key). v1 is retained only for deprecated apk_ keys.
DEVIN_API_FLAVOR=v3
DEVIN_APP_BASE=https://app.devin.ai
# Per-session ACU ceilings
DEVIN_ORCHESTRATOR_ACU_LIMIT=8
DEVIN_CHILD_ACU_LIMIT=5
# Polling / retry behaviour
DEVIN_POLL_INTERVAL_SECONDS=10
DEVIN_SESSION_TIMEOUT_SECONDS=1800
AGENT_MAX_ATTEMPTS=2
# Repository available in every Devin session. Connect it in Devin first.
DEVIN_CHILD_REPO=https://github.com/yacine-baghli/DYB-Pro
# Optional comma-separated Devin organization secret IDs for approved compute
# providers. Values stay in Devin; DYB Pro passes IDs, never secret values.
DEVIN_SECRET_IDS=

# --- GPU inference (optional in "auto", mandatory when a UI tool is "required") ---
# Cloudflare has no GPU. Point these at authenticated NVIDIA BioNeMo NIM services (or compatible
# gateways) running on a GPU host. A base URL or the complete endpoint URL is accepted.
ALPHAFOLD_API_URL=
ALPHAFOLD_API_KEY=
ALPHAFOLD_MODEL_VERSION=alphafold2-nim
ALPHAFOLD_TIMEOUT_SECONDS=3600
PROTEINMPNN_API_URL=
PROTEINMPNN_API_KEY=
PROTEINMPNN_MODEL_VERSION=proteinmpnn-nim
PROTEINMPNN_TIMEOUT_SECONDS=900
PROTEINMPNN_NUM_SEQUENCES=8
PROTEINMPNN_SAMPLING_TEMPERATURE=0.1
PROTEINMPNN_RANDOM_SEED=37

# Set to true ONLY for offline demos: agent runs execute the same toolkit
# in-process and are explicitly labelled "local-simulation" everywhere.
ALLOW_LOCAL_SIMULATION=true

# --- OpenAI (structured / multimodal analysis, optional) -------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- Research daemon -------------------------------------------------------
RESEARCH_DAEMON_ENABLED=true
RESEARCH_DEBOUNCE_SECONDS=5
RESEARCH_TICK_SECONDS=15
RESEARCH_ACU_LIMIT=3
RESEARCH_MAX_TOPICS_PER_EVENT=4

# --- Core services ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg://dybpro:dybpro@db:5432/dybpro
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO / S3) ------------------------------------------
S3_ENDPOINT_URL=http://objectstore:9000
S3_ACCESS_KEY=dybpro
S3_SECRET_KEY=dybpro123
S3_BUCKET=dybpro
S3_REGION=us-east-1
LOCAL_ARTIFACT_DIR=/data/artifacts

# --- App -------------------------------------------------------------------
APP_ENV=demo
LOG_LEVEL=INFO
# Demo API keys created by the seeder (rotate for anything real).
SEED_ADMIN_API_KEY=dyb-pro-demo-admin
SEED_SCIENTIST_API_KEY=dyb-pro-demo-scientist
SEED_VIEWER_API_KEY=dyb-pro-demo-viewer
DEFAULT_ACU_QUOTA=200
DEFAULT_CYCLE_QUOTA=25
CORS_ORIGINS=http://localhost:3000

# --- Web -------------------------------------------------------------------
# Empty keeps the browser on same-origin proxy mode. Set this only for legacy
# direct-to-backend development.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_DEMO_API_KEY=dyb-pro-demo-scientist
DYB_PRO_BACKEND_URL=http://api:8000
DYB_PRO_API_KEY=dyb-pro-demo-scientist
# Optional Basic-auth gate for private previews (disabled unless both are set).
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
# NEXT_PUBLIC_DEMO_API_KEY is no longer needed in proxy mode.
