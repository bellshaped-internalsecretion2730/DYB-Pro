# ---------------------------------------------------------------------------
# DYB Pro environment. Copy to .env — never commit real keys.
# ---------------------------------------------------------------------------

# --- Devin (required for real agent orchestration) -------------------------
# Get a key at https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=
# Org id (prefix org-). Required for the v3 organization API ("cog_" keys).
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
# v3 (organization-scoped, "cog_" keys) or v1 (legacy personal keys)
DEVIN_API_FLAVOR=v3
DEVIN_APP_BASE=https://app.devin.ai
# Per-session ACU ceilings
DEVIN_ORCHESTRATOR_ACU_LIMIT=8
DEVIN_CHILD_ACU_LIMIT=5
# Polling / retry behaviour
DEVIN_POLL_INTERVAL_SECONDS=10
DEVIN_SESSION_TIMEOUT_SECONDS=1800
AGENT_MAX_ATTEMPTS=2
# Repo the child agents may be pointed at (optional)
DEVIN_CHILD_REPO=

# Set to true ONLY for offline demos: agent runs execute the same toolkit
# in-process and are explicitly labelled "local-simulation" everywhere.
ALLOW_LOCAL_SIMULATION=true

# --- OpenAI (structured / multimodal analysis, optional) -------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# --- Research daemon -------------------------------------------------------
RESEARCH_DAEMON_ENABLED=true
RESEARCH_DEBOUNCE_SECONDS=5
RESEARCH_TICK_SECONDS=15
RESEARCH_ACU_LIMIT=3
RESEARCH_MAX_TOPICS_PER_EVENT=4

# --- Core services ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg://dybpro:dybpro@db:5432/dybpro
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Object storage (MinIO / S3) ------------------------------------------
S3_ENDPOINT_URL=http://objectstore:9000
S3_ACCESS_KEY=dybpro
S3_SECRET_KEY=dybpro123
S3_BUCKET=dybpro
S3_REGION=us-east-1
LOCAL_ARTIFACT_DIR=/data/artifacts

# --- App -------------------------------------------------------------------
APP_ENV=demo
LOG_LEVEL=INFO
# Demo API keys created by the seeder (rotate for anything real).
SEED_ADMIN_API_KEY=dyb-pro-demo-admin
SEED_SCIENTIST_API_KEY=dyb-pro-demo-scientist
SEED_VIEWER_API_KEY=dyb-pro-demo-viewer
DEFAULT_ACU_QUOTA=200
DEFAULT_CYCLE_QUOTA=25
CORS_ORIGINS=http://localhost:3000

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DEMO_API_KEY=dyb-pro-demo-scientist
